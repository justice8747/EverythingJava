# =======================================================
# PlaySwap Microservices Server — Environment Variables Template
# Copy this file to .env in each microservice folder or root
# =======================================================

# Database Configuration (PostgreSQL / MySQL)
DB_AUTH_URL=jdbc:postgresql://localhost:5432/playswap
DB_AUTH_USERNAME=postgres
DB_AUTH_PASSWORD=your_db_password

# Spotify OAuth Credentials (from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URL=http://127.0.0.1:8080/login/oauth2/code/spotify

# Google / YouTube OAuth Credentials (from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_API_KEY=your_google_api_key
YOUTUBE_REDIRECT_URl=http://127.0.0.1:8080/login/oauth2/code/google

# Keycloak Administration Credentials
KEYCLOAK_BASE_URL=http://localhost:8181
KEYCLOAK_REALM=playswap-realm
KEYCLOAK_CLIENT_ID=playswap-client-credentials-id
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret

# Microservices Communication Shared Secret
INTERNAL_API_SECRET=your_internal_api_secret

# Frontend Origin URL
FRONTEND_URL=http://127.0.0.1:5173
